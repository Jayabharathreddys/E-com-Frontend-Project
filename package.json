{
    "name": "ecomm-app",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"*.{js,jsx,json,html,css}\"",
        "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"*.{js,jsx,json,html,css}\"",
        "prepare": "husky"
    },
    "lint-staged": {
        "src/**/*.{js,jsx}": [
            "eslint --fix --max-warnings 0",
            "prettier --write"
        ],
        "src/**/*.css": [
            "prettier --write"
        ],
        "*.{json,html,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "axios": "^1.6.7",
        "jspdf": "^4.2.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-icons": "^5.0.1",
        "react-router-dom": "^6.21.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "@testing-library/jest-dom": "^6.4.2",
        "@testing-library/react": "^15.0.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@vitejs/plugin-react": "^4.2.1",
        "eslint": "^8.55.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.5",
        "husky": "^9.1.7",
        "jsdom": "^24.0.0",
        "lint-staged": "^16.4.0",
        "momentic": "^2.124.0",
        "prettier": "^3.8.3",
        "vite": "^5.0.8",
        "vitest": "^1.2.2"
    }
}
